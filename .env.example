# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=

# ==========================================
# 세이프가든(Safe Garden) 관리자 알림 & 데이터 연동 설정
# ==========================================

# 1. 관리자 알림 수신 이메일 주소 (신규 상담 접수 시 알림을 받을 이메일)
ADMIN_EMAIL=cuthip@gmail.com

# 2. Google Sheets 저장 연동
# 방법 A (가장 간편한 방법 - 권장): Google Apps Script 웹앱 URL
# 구글 시트 메뉴 [확장 프로그램] > [Apps Script]에서 웹앱 배포 후 발급받은 URL을 입력합니다.
GOOGLE_SHEET_WEBHOOK_URL=

# 방법 B: 구글 서비스 계정(Google Cloud Service Account) 방식 (선택 사항)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# 3. 신규 상담 접수 시 관리자 이메일 자동 발송 (Gmail / SMTP)
# 구글 계정 2단계 인증 후 생성한 "앱 비밀번호(App Password)" 16자리를 입력합니다.
GMAIL_USER=cuthip@gmail.com
GMAIL_APP_PASSWORD=

# 4. 관리자 페이지 로그인 인증 계정 (기본값: ID: cuthip / PASS: hip1521!)
ADMIN_USER=cuthip
ADMIN_PASSWORD=hip1521!
